---
layout: layouts/base.njk
title: Archive
permalink: /archive/
eleventyExcludeFromCollections: true
---
<h3 id="logo"><a href="/">&larr; {{ metadata.siteName }}</a></h3>
<header>
  <h1>Archive</h1>
</header>
<article id="archive_container">
  {% for group in collections.postsByYear %}
  <section>
    <h3>{{ group.year }}</h3>
    <ul>
      {% for post in group.posts %}
      <li><a href="{{ post.url }}">{{ post.data.title }}</a> &mdash; <span class="date">{{ post.date | dateReadable }}</span></li>
      {% endfor %}
    </ul>
  </section>
  {% endfor %}
</article>
