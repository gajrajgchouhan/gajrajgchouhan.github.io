---
layout: layouts/base.njk
pagination:
  data: collections.siteCollections
  size: 1
  alias: coll
permalink: "/collection-{{ coll.slug }}/"
eleventyComputed:
  title: "Collection: {{ coll.name }}"
eleventyExcludeFromCollections: true
---
<h3 id="logo"><a href="/">&larr; {{ metadata.siteName }}</a></h3>
<header>
  <h1>Collection: {{ coll.name }}</h1>
</header>
<article>
  <div id="collection">
    {% for post in coll.posts %}
    <div><a href="{{ post.url }}">{{ post.data.title }}</a> &mdash; <span class="date">{{ post.date | dateReadable }}</span></div>
    {% endfor %}
  </div>
</article>
